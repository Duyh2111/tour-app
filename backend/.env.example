# ─── Supabase (Project Settings → Database → Connection String) ────────────────
# Pooling URL — used by Prisma at runtime
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct URL — used by Prisma for migrations
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres"

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production      # IMPORTANT: set to "production" on Render

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d

# ─── Cloudinary (free at cloudinary.com) ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Admin seed account ────────────────────────────────────────────────────────
# Used by: npm run seed
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeMe_Strong@Password123
ADMIN_NAME=Super Admin

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Set to your actual Vercel production URL (no trailing slash)
FRONTEND_URL=https://your-app.vercel.app
